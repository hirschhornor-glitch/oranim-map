# Ignore editor/IDE files
.DS_Store
*.swp
*.swo
*~

# Claude Code local settings
.claude/

# Private dev notes
NEW_CONVERSATION_PROMPT.md

# Tooling intermediate files (not used by the site)
data/gmaps_lookup.json

# Local backups (created by data-update scripts, not for deploy)
*.bak
*.bak_*
*.bak.*
*.backup_*

# Raw dated scraper snapshots (superseded by the merged *.json; not for deploy)
data/*_scraped.json

# Build source map (regenerated by CI; not shipped to keep the CDN payload small)
app.js.map

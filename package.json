{
  "name": "oranim-map",
  "version": "1.0.0",
  "private": true,
  "description": "Oranim urban planning GIS map — Jerusalem",
  "scripts": {
    "build": "babel src/app.jsx --presets=@babel/preset-react --out-file app.js",
    "build:debug": "babel src/app.jsx --presets=@babel/preset-react --out-file app.js --source-maps",
    "build:junction": "babel src/junction.jsx --presets=@babel/preset-react --out-file junction.js",
    "build:all": "npm run build && npm run build:junction && npm run build:commerce",
    "build:commerce": "babel src/commerce.jsx --presets=@babel/preset-react --out-file commerce.js"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.0",
    "@babel/core": "^7.24.0",
    "@babel/preset-react": "^7.24.0"
  }
}
